SECRET_KEY=replace-with-a-long-random-value
# Used only to bootstrap the first database-backed super-admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: set both values to require Cloudflare Turnstile for signup and login.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_TIMEOUT=5
# Optional: enables Google Places autocomplete in the admin court form.
GOOGLE_MAPS_API_KEY=
# Optional: enable per-court system push notifications.
# Generate one persistent VAPID key pair and keep the private key secret.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Use a contact URI controlled by the operator, such as mailto:admin@example.com.
WEB_PUSH_SUBJECT=
WEB_PUSH_TIMEOUT=5
# Optional: Android app push notifications through Firebase Cloud Messaging.
# Path to a Firebase service account key (Project settings > Service accounts).
# Keep it secret, e.g. inside the persistent instance directory.
FCM_SERVICE_ACCOUNT_FILE=
FCM_TIMEOUT=5
# Optional overrides; the project bundles FFmpeg and Noto Sans TC.
SOCIAL_THUMBNAIL_FFMPEG=
SOCIAL_THUMBNAIL_FONT=
# Set to 1 when the app is served exclusively over HTTPS.
SESSION_COOKIE_SECURE=0
# Set only behind a trusted proxy that overwrites forwarded IP/protocol headers.
TRUST_PROXY_HEADERS=0
# Optional local MaxMind GeoLite2/GeoIP2 Country database.
# Common Cloudflare, CloudFront, and Vercel country headers work without this.
GEOIP_COUNTRY_DB=
# Optional two-letter fallback when no country signal is available.
# Leave empty to default unknown visitors to en-US.
DEFAULT_COUNTRY_CODE=
# Public deployment details shown on the privacy policy page.
PRIVACY_OPERATOR_NAME=
PRIVACY_DATA_REGION=
# Optional mailto: or HTTPS contact for privacy requests.
PRIVACY_CONTACT=
# Optional mailto: or HTTPS contact for general administrator/support requests.
ADMIN_CONTACT=
# Optional public contact IDs; the website builds their official links.
# Discord invite code (the part after discord.gg/).
ADMIN_CONTACT_DISCORD=
# LINE Official Account ID, with or without its leading @.
ADMIN_CONTACT_LINE=
# Telegram public username, with or without its leading @.
ADMIN_CONTACT_TELEGRAM=
# Optional new-message delivery. These values are server-side secrets.
# Telegram gets every new message whenever both Telegram values are set;
# Discord only after an administrator turns it on in /admin/messages.
CONTACT_DISCORD_WEBHOOK_URL=
CONTACT_TELEGRAM_BOT_TOKEN=
CONTACT_TELEGRAM_CHAT_ID=
CONTACT_NOTIFICATION_TIMEOUT=5
# Optional HTTPS download link for the Android app, shown on /android.
ANDROID_APP_URL=
# Failed sign-ins allowed before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
# Temporary sign-in lockout length in seconds (default: 15 minutes).
LOGIN_LOCKOUT_SECONDS=900
# Failed nickname/PIN leave attempts allowed before a temporary lockout.
LEAVE_MAX_ATTEMPTS=5
# Temporary leave-attempt lockout length in seconds (default: 15 minutes).
LEAVE_LOCKOUT_SECONDS=900
# Lifetime in days of bearer tokens issued by the JSON API (/api/v1).
API_TOKEN_TTL_DAYS=90
# Optional version string reported by GET /api/v1/version and /status.
# Defaults to the newest date in data/update_history.json.
APP_VERSION=
