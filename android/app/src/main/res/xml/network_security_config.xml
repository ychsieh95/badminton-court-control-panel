<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted deployments are often reached over plain HTTP on a LAN or the emulator
     loopback (10.0.2.2), so cleartext is allowed. Use https:// for anything public. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
